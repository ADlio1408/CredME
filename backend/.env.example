# Copy to .env and set real values before any shared/public deployment.
# If unset, the API falls back to published, insecure development keys
# (see backend/api.py) — fine for local demos, never for anything shared.
#
# Two roles/scopes:
#   APPLICANT — used by the frontend. Can request assessments only.
#   ADMIN     — everything APPLICANT can do, plus internal-only endpoints
#               (live transaction ingestion, LLM narrative generation).
CREDME_API_KEY_APPLICANT=changeme-applicant
CREDME_API_KEY_ADMIN=changeme-admin

# Optional: enables real LLM calls for POST /explain/narrative (admin-only).
# If unset, that endpoint returns a clearly-labeled template-based
# narrative instead of calling out to a real model. See backend/llm_layer.py.
# CREDME_LLM_API_KEY=
